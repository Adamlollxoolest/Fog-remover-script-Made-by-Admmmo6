local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

-- Continuous zero-delay cleanup loop running every frame
RunService.Heartbeat:Connect(function()
    -- 1. Force Lighting properties to maximum clarity
    Lighting.FogEnd = 9e9
    Lighting.FogStart = 0
    
    -- 2. Instantly wipe out any atmosphere or post-processing visual clutter in Lighting
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Atmosphere") or child:IsA("PostEffect") or child:IsA("BlurEffect") or child:IsA("SunRaysEffect") then
            child:Destroy()
        end
    end
    
    -- 3. Instantly destroy any parts, folders, or models acting as fog triggers/zones
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Atmosphere") then
            obj:Destroy()
        elseif obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") then
            local name = string.lower(obj.Name)
            if string.find(name, "fog") or string.find(name, "mist") or string.find(name, "weather") or string.find(name, "smoke") or string.find(name, "hazard") then
                obj:Destroy()
            end
        end
    end
end)

print("Infinite zero-delay fog remover active.")
